{
  "name": "jungle-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Desafio técnico: processador distribuído de apostas da Jungle Gaming",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "bun --watch src/main.ts",
    "lint": "eslint '{src,test}/**/*.ts' --max-warnings=0",
    "test": "bun test --path-ignore-patterns=dist",
    "test:unit": "bun test test/unit --path-ignore-patterns=dist",
    "test:integration": "bun test test/integration --path-ignore-patterns=dist",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down"
  },
  "engines": { "bun": ">=1.1" },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.721.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/cli": "^7.2.5",
    "@mikro-orm/decorators": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "latest",
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
